includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    # strictest level for a small app; relax if noise outweighs value
    level: 8

    tmpDir: storage/framework/cache/phpstan

    ignoreErrors:
        # FiltersAndSorts trait: PHPStan cannot resolve generic Builder|Relation
        # types when the trait is expanded into each consuming controller class.
        # These are false positives — the template annotations are correct.
        -
            identifier: missingType.generics
            path: app/Traits/FiltersAndSorts.php
        -
            identifier: argument.type
            path: app/Traits/FiltersAndSorts.php
        # DispatchGenerationAction: request->user() returns User|null but
        # create() requires User — middleware guarantees a logged-in user.
        -
            identifier: argument.type
            path: app/Actions/Ai/DispatchGenerationAction.php
