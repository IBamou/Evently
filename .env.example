APP_NAME=Evently
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=evently
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments (mock confirmation gate — set to false when a real provider is wired up)
PAYMENTS_MOCK_CONFIRM=true

# AI Event Copilot
AI_EVENT_COPILOT_ENABLED=false
AI_EVENT_COPILOT_PROVIDER=openrouter
AI_EVENT_COPILOT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
AI_EVENT_COPILOT_TIMEOUT=30
AI_EVENT_COPILOT_DAILY_LIMIT=50
AI_EVENT_COPILOT_PER_MINUTE_LIMIT=5
AI_EVENT_COPILOT_PROMPT_VERSION=event-copilot-v1

# OpenRouter (primary provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (fallback provider)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_EVENT_COPILOT_FALLBACK_PROVIDER=groq
AI_EVENT_COPILOT_FALLBACK_MODEL=openai/gpt-oss-20b
